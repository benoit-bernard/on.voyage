@page "/lieu/{Slug}"
@inject ICatalogClient Catalog
@inject IProfileStore Profiles
@inject InteractionRecorder Recorder
@inject TimeProvider Clock
@inject IReportClient Reports
@inject AudioPlaybackController Player

<PageTitle>@(_poi?.Name ?? "Lieu") · ON.VOYAGE</PageTitle>

<a class="back" href="">← Retour</a>

@if (_notFound)
{
    <p class="empty">Ce lieu est introuvable.</p>
}
else if (_poi is null)
{
    <p class="empty" aria-live="polite">Chargement…</p>
}
else
{
    <h1>@_poi.Name</h1>
    @if (_poi.HiddenGem)
    {
        <span class="gem">Pépite · moins fréquenté</span>
    }

    <div class="actions">
        <a class="btn btn-soft" href="@NavigateUri" @onclick="() => RecordAsync(InteractionKinds.Navigate)">📍 Y aller</a>
        <button class="btn @(_saved ? "btn-on" : "")" aria-pressed="@(_saved ? "true" : "false")" @onclick="ToggleSavedAsync">
            @(_saved ? "★ Dans vos envies" : "☆ Ajouter à mes envies")
        </button>
        <button class="btn btn-soft" @onclick="() => RecordAsync(InteractionKinds.Like)">👍</button>
        <button class="btn btn-soft" @onclick="() => RecordAsync(InteractionKinds.DislikePoi)">👎</button>
    </div>

    @if (_poi.Stories.Count == 0)
    {
        <p class="note" role="status">Histoire bientôt disponible.</p>
    }

    @foreach (var story in _poi.Stories)
    {
        <article>
            <h2>@story.Title</h2>
            @if (string.IsNullOrEmpty(story.AudioUrl) && !string.IsNullOrWhiteSpace(story.Text) && Player.CanNarrate)
            {
                @* Published without a recorded voice: the device reads the text itself (ITextNarrator). Nothing leaves the device. *@
                <button type="button" class="btn btn-soft narrate" @onclick="() => NarrateAsync(story)">🔊 Écouter avec la voix de l'appareil</button>
                <p class="note">@AudioSettings.DeviceVoiceNotice. L'enregistrement de cette histoire n'est pas encore disponible.</p>
            }
            else
            {
                <AudioPlayer Source="@story.AudioUrl" />
            }
            <details class="transcript">
                <summary>Transcription de l'histoire</summary>
                <p>@story.Text</p>
            </details>
            @if (!story.AiGenerated)
            {
                <p class="note">Texte éditorial, en attente de relecture.</p>
            }
            <details class="report" open="@(_reporting == story.Id)">
                <summary @onclick="() => _reporting = story.Id" @onclick:preventDefault>Signaler une erreur</summary>
                @if (_reported.Contains(story.Id))
                {
                    <p class="note" role="status">Merci, votre signalement a été transmis.</p>
                }
                else if (_reporting == story.Id)
                {
                    <label>Type
                        <select @bind="_reportKind" aria-label="Type de signalement">
                            @foreach (var kind in Enum.GetValues<ReportKind>())
                            {
                                <option value="@kind">@ReportLabels.Label(kind)</option>
                            }
                        </select>
                    </label>
                    <label>Votre message (500 caractères au plus)
                        <textarea maxlength="@IReportClient.MaxLength" @bind="_reportText" @bind:event="oninput" rows="3"></textarea>
                    </label>
                    <p class="note">Votre position n'est pas envoyée.</p>
                    @if (_reportError is not null)
                    {
                        <p class="note" role="alert">@_reportError</p>
                    }
                    <button type="button" class="btn" disabled="@(string.IsNullOrWhiteSpace(_reportText))" @onclick="() => ReportAsync(story.Id)">Envoyer</button>
                }
            </details>
        </article>
    }

    <CreatorsBlock PoiId="_poi.Id" Weights="_weights" />

    @if (_poi.Links is { Count: > 0 } links)
    {
        <section class="learn-more" aria-labelledby="learn-more-title">
            <h2 id="learn-more-title">En savoir plus</h2>
            <p class="note">Ces liens ouvrent un site ou une application extérieurs à ON.VOYAGE.</p>
            <ul>
                @foreach (var link in links)
                {
                    <li>
                        @* A plain link out: no embedded player, so YouTube sees nothing until the traveler chooses to open it. *@
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer">
                            @if (link.ThumbnailUrl is not null)
                            {
                                <img src="@link.ThumbnailUrl" alt="" width="96" loading="lazy" />
                            }
                            <span>@LinkLabel(link)</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    <footer class="sources">Sources : @string.Join(" · ", _poi.Attributions)</footer>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private PoiDetailDto? _poi;
    private IReadOnlyDictionary<string, double> _weights = new Dictionary<string, double>();
    private bool _notFound;
    private bool _saved;
    private Guid? _reporting;
    private readonly HashSet<Guid> _reported = [];
    private ReportKind _reportKind = ReportKind.InaccurateFact;
    private string _reportText = string.Empty;
    private string? _reportError;

    /// <summary>A <c>geo:</c> link: the traveler's own navigation app takes over, ON.VOYAGE computes no route (F-05).</summary>
    private string NavigateUri => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"geo:{_poi!.Latitude:0.#####},{_poi.Longitude:0.#####}?q={_poi.Latitude:0.#####},{_poi.Longitude:0.#####}({Uri.EscapeDataString(_poi.Name)})");

    private async Task ReportAsync(Guid storyId)
    {
        _reportError = null;
        try
        {
            await Reports.ReportAsync(storyId, _reportKind, _reportText, CancellationToken.None);
            _reported.Add(storyId);
            _reportText = string.Empty;
        }
        catch (HttpRequestException)
        {
            _reportError = "Envoi impossible pour l'instant. Réessayez plus tard.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _poi = null;
        _notFound = false;
        var detail = await Catalog.GetPoiAsync(Slug, CancellationToken.None);
        if (detail is null)
        {
            _notFound = true;
            return;
        }

        var profile = await Profiles.LoadAsync(CancellationToken.None);
        var summaries = await Catalog.GetPoisAsync("marseille", null, null, CancellationToken.None);
        _weights = summaries.FirstOrDefault(poi => poi.Id == detail.Id)?.Weights ?? _weights;
        _saved = profile.Saved.Contains(detail.Id);
        _poi = detail;
    }

    private static string LinkLabel(LinkDto link) => link.Kind switch
    {
        "youtube" => $"Vidéo : {link.Title}{(string.IsNullOrEmpty(link.Channel) ? string.Empty : $" ({link.Channel})")}",
        "wikipedia" => $"Wikipédia : {link.Title}",
        _ => link.Title,
    };

    private async Task ToggleSavedAsync()
    {
        var profile = await Profiles.LoadAsync(CancellationToken.None);
        var updated = ProfileUpdater.ToggleSaved(profile, _poi!.Id, Clock.GetUtcNow());
        await Profiles.SaveAsync(updated, CancellationToken.None);
        _saved = updated.Saved.Contains(_poi.Id);
        if (_saved)
        {
            // Saving is a learning signal (kind "save"); un-saving teaches nothing.
            await Recorder.RecordAsync(InteractionKinds.Save, _poi.Id, _weights);
        }
    }

    private Task NarrateAsync(StoryDto story) =>
        Player.PlayNowAsync(new PlayRequest(story.Id, _poi!.Id, story.Title, [], PlayOrigin.Manual, story.DurationSeconds > 0 ? story.DurationSeconds : null, _weights, story.Text, story.Language));

    private Task RecordAsync(string kind) => Recorder.RecordAsync(kind, _poi!.Id, _weights);
}

@page "/recherche"
@implements IDisposable
@inject SearchSession Session

<PageTitle>Recherche · ON.VOYAGE</PageTitle>

<h1>Recherche</h1>

<form role="search" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <label for="search-input" class="sr-only">Rechercher un lieu</label>
    <input id="search-input" type="search" autocomplete="off" enterkeyhint="search" placeholder="Un lieu, un fort, un volcan…" maxlength="100"
           value="@_text" @oninput="OnInput" aria-describedby="search-status" />
</form>

<p id="search-status" class="hint" role="status" aria-live="polite">@Status()</p>

@if (_state.Results.Count > 0)
{
    <ul class="results">
        @foreach (var poi in _state.Results)
        {
            <li>
                <a href="lieu/@poi.Slug">
                    <strong>@poi.Name</strong>
                    <span class="meta">@HomeFeedService.Label(poi.Category)@(poi.AudioSeconds is not null ? " · avec audio" : "")</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private SearchState _state = SearchState.Initial;
    private string _text = string.Empty;

    protected override void OnInitialized()
    {
        _state = Session.State;
        _text = _state.Text;
        Session.Changed += OnChanged;
    }

    private void OnChanged()
    {
        _state = Session.State;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnInput(ChangeEventArgs args)
    {
        _text = args.Value?.ToString() ?? string.Empty;
        Session.OnInput(_text);
    }

    private Task SubmitAsync() => Session.SearchNowAsync(_text);

    private string Status() => _state.Status switch
    {
        SearchStatus.TooShort => "Tapez au moins 2 caractères.",
        SearchStatus.Searching => "Recherche…",
        SearchStatus.Empty => $"Aucun lieu ne correspond à « {_state.Text} ».",
        SearchStatus.Failed => "Impossible de chercher sans réseau : téléchargez le pack hors ligne de la destination pour chercher sans connexion.",
        SearchStatus.Results when _state.FromPack => $"{_state.Results.Count} résultat(s) dans le pack hors ligne.",
        SearchStatus.Results => $"{_state.Results.Count} résultat(s).",
        _ => "Cherchez un lieu par son nom, ou par un mot comme « fort », « romain », « volcan ».",
    };

    public void Dispose() => Session.Changed -= OnChanged;
}

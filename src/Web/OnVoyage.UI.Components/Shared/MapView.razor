@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="map-wrap">
    <div @ref="_container" class="map" role="application" aria-label="Carte des lieux"></div>
    <p class="attribution-fixed">@MapSettings.Attribution</p>
</div>

@code {
    public const string ModulePath = "./_content/OnVoyage.UI.Components/js/map.js";

    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MapView>? _reference;
    private MapGeoJson _features = new("FeatureCollection", []);
    private bool _fitPending;

    [Parameter, EditorRequired] public MapSettings Settings { get; set; } = new();

    /// <summary>The places to draw, already filtered by the parent.</summary>
    [Parameter] public MapGeoJson Features { get; set; } = new("FeatureCollection", []);

    [Parameter] public (double Latitude, double Longitude, double Accuracy)? UserLocation { get; set; }

    [Parameter] public EventCallback<Guid> PoiTapped { get; set; }

    [Parameter] public EventCallback<(MapBounds Bounds, double Zoom)> ViewportChanged { get; set; }

    protected override void OnParametersSet() => _fitPending = _fitPending || _module is null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Settings.TilesUrl is not null)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _container, _reference, new
            {
                tilesUrl = Settings.TilesUrl,
                glyphsUrl = Settings.GlyphsUrl,
            });
            _fitPending = true;
        }

        if (_module is null)
        {
            return;
        }

        if (!ReferenceEquals(_features, Features))
        {
            _features = Features;
            await _module.InvokeVoidAsync("setPois", Features);
            if (_fitPending && MapFeatures.BoundsOf(Features) is { } bounds)
            {
                _fitPending = false;
                await _module.InvokeVoidAsync("fitBounds", bounds.West, bounds.South, bounds.East, bounds.North);
            }
        }

        if (UserLocation is { } me)
        {
            await _module.InvokeVoidAsync("setUserLocation", me.Latitude, me.Longitude, me.Accuracy);
        }
    }

    [JSInvokable]
    public Task OnPoiTapped(string id) => Guid.TryParse(id, out var poi) ? PoiTapped.InvokeAsync(poi) : Task.CompletedTask;

    [JSInvokable]
    public Task OnViewportChanged(double west, double south, double east, double north, double zoom) =>
        ViewportChanged.InvokeAsync((new MapBounds(west, south, east, north), zoom));

    /// <summary>Re-centres on a given area, for the "my position" and "show all" buttons.</summary>
    public async Task FitAsync(MapBounds bounds)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("fitBounds", bounds.West, bounds.South, bounds.East, bounds.North);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _reference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

@inherits LayoutComponentBase

<div class="shell">
    <header class="top">
        <a class="brand" href="/admin">ON.VOYAGE <span>Atelier</span></a>
        <AuthorizeView>
            <Authorized>
                <nav aria-label="Navigation principale">
                    <NavLink href="/admin" Match="NavLinkMatch.All">Accueil</NavLink>
                    <NavLink href="/admin/places">Lieux</NavLink>
                    <NavLink href="/admin/workshop">Atelier</NavLink>
                    <NavLink href="/admin/kpis">Indicateurs</NavLink>
                    <NavLink href="/admin/reports">Signalements</NavLink>
                    <NavLink href="/admin/batches">Lots</NavLink>
                    <NavLink href="/admin/config">Configuration</NavLink>
                    <NavLink href="/admin/references">Référentiels</NavLink>
                    <NavLink href="/admin/audit">Journal</NavLink>
                </nav>
                <form method="post" action="/logout" class="signout">
                    <AntiforgeryToken />
                    <span class="who">@context.User.FindFirst("email")?.Value</span>
                    <button type="submit" class="ghost">Se déconnecter</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>
    <main>@Body</main>
</div>

@page "/admin/batches"
@attribute [Authorize(Policy = AdminClaims.PolicyName)]
@implements IDisposable
@inherits AdminPageBase

<h1>Génération en masse</h1>
<Status Message="@Message" Error="@Error" />

<section class="card">
    <h2>Nouveau lot</h2>
    <p class="muted">Les histoires sont écrites à partir des faits puis contrôlées. Rien n'est voisé ni publié : chaque texte attend une relecture dans l'atelier.</p>
    <div class="row">
        <div>
            <label for="destination">Destination</label>
            <select id="destination" @bind="_destination">
                @foreach (var destination in _destinations)
                {
                    <option value="@destination.Slug">@destination.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="minimum">Importance minimale (0–100)</label>
            <input id="minimum" type="number" min="0" max="100" @bind="_minImportance" />
        </div>
        <div>
            <label for="limit">Nombre de lieux (1–200)</label>
            <input id="limit" type="number" min="1" max="200" @bind="_limit" />
        </div>
        <div>
            <label for="budget">Plafond de coût (USD, facultatif)</label>
            <input id="budget" type="number" min="0" step="0.5" @bind="_budget" />
        </div>
        <div>
            <label for="lang">Langue</label>
            <select id="lang" @bind="_lang"><option value="fr">Français</option><option value="en">English</option></select>
        </div>
        <div>
            <label for="kind">Type</label>
            <select id="kind" @bind="_kind">
                <option value="Standard">@Labels.Kind("Standard")</option>
                <option value="Anecdote">@Labels.Kind("Anecdote")</option>
            </select>
        </div>
    </div>
    <div class="row">
        <label class="check"><input type="checkbox" @bind="_candidates" /> Lieux candidats</label>
        <label class="check"><input type="checkbox" @bind="_published" /> Lieux publiés</label>
        <button type="button" class="primary" disabled="@(Busy || _destination is null || (!_candidates && !_published))" @onclick="Start">Lancer le lot</button>
    </div>
    <p class="muted">Les lieux déjà dotés d'une histoire dans cette langue sont ignorés ; les plus importants passent en premier.</p>
</section>

<section class="card">
    <h2>Lots</h2>
    <div class="row">
        <div>
            <label for="filter-status">État</label>
            <select id="filter-status" @bind="_statusFilter">
                <option value="">Tous</option>
                <option value="running">En cours</option>
                <option value="failures">Avec échecs</option>
                <option value="completed">Terminés sans échec</option>
                <option value="cancelled">Arrêtés</option>
            </select>
        </div>
        <div>
            <label for="filter-destination">Destination</label>
            <select id="filter-destination" @bind="_destinationFilter">
                <option value="">Toutes</option>
                @foreach (var destination in _destinations)
                {
                    <option value="@destination.Slug">@destination.Name</option>
                }
            </select>
        </div>
        <a href="/admin/dead-letters">Lettres mortes</a>
        <a href="/admin/bootstrap">Amorçage d'une destination</a>
    </div>
    @if (Visible.Count == 0)
    {
        <p class="muted">@(_batches.Count == 0 ? "Aucun lot pour l'instant." : "Aucun lot ne correspond à ces filtres.")</p>
    }
    else
    {
        <table>
            <thead><tr><th>Lancé</th><th>Destination</th><th>État</th><th>Avancement</th><th></th></tr></thead>
            <tbody>
                @foreach (var batch in Visible)
                {
                    <tr>
                        <td>@batch.Batch.CreatedAt.ToString("dd/MM HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@batch.Batch.Criteria.Destination · @batch.Batch.Criteria.Lang · @Labels.Kind(batch.Batch.Criteria.Kind)</td>
                        <td>@Labels.Batch(Status(batch))</td>
                        <td>
                            <BatchSummary Progress="batch" />
                            <progress max="@batch.Batch.Total" value="@(batch.Succeeded + batch.Failed + batch.Cancelled)" aria-label="Avancement du lot"></progress>
                        </td>
                        <td><a href="/admin/batches/@batch.Batch.Id">Détail</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private IReadOnlyList<DestinationItem> _destinations = [];
    private IReadOnlyList<BatchProgressItem> _batches = [];
    private string? _destination;
    private int? _minImportance;
    private int _limit = 20;
    private double? _budget;
    private string _statusFilter = string.Empty;
    private string _destinationFilter = string.Empty;
    private string _lang = "fr";
    private string _kind = "Standard";
    private bool _candidates = true;
    private bool _published = true;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _destinations = await LoadAsync(() => Api.GetDestinationsAsync()) ?? [];
        _destination = _destinations.FirstOrDefault()?.Slug;
        await ReloadAsync();
        _timer = new Timer(_ => _ = InvokeAsync(RefreshWhileRunningAsync), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private static string Status(BatchProgressItem batch) =>
        batch.Status is { Length: > 0 } status ? status : !batch.IsFinished ? "running" : batch.Cancelled > 0 ? "cancelled" : batch.Failed > 0 ? "completed_with_failures" : "completed";

    private IReadOnlyList<BatchProgressItem> Visible => [.. _batches
        .Where(batch => _destinationFilter.Length == 0 || batch.Batch.Criteria.Destination == _destinationFilter)
        .Where(batch => _statusFilter switch
        {
            "running" => Status(batch) == "running",
            "failures" => batch.Failed > 0,
            "completed" => Status(batch) == "completed",
            "cancelled" => batch.Cancelled > 0,
            _ => true,
        })];

    private async Task ReloadAsync() => _batches = await LoadAsync(() => Api.ListBatchesAsync(20)) ?? _batches;

    private async Task RefreshWhileRunningAsync()
    {
        if (_batches.Any(batch => !batch.IsFinished))
        {
            await ReloadAsync();
            StateHasChanged();
        }
    }

    private async Task Start()
    {
        List<string> statuses = [];
        if (_candidates)
        {
            statuses.Add("Candidate");
        }

        if (_published)
        {
            statuses.Add("Published");
        }

        await RunAsync(async () => await Api.CreateBatchAsync(new NewBatch(_destination!, _minImportance, statuses, _lang, _kind, _limit, _budget is > 0 ? _budget : null)), "Lot lancé : l'avancement se met à jour tout seul.");
        await ReloadAsync();
    }

    public void Dispose() => _timer?.Dispose();
}

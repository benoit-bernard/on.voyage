@page "/admin/audit"
@attribute [Authorize(Policy = AdminClaims.PolicyName)]
@inherits AdminPageBase

<h1>Journal des actions</h1>
<Status Message="@Message" Error="@Error" />

<section class="card">
    <p class="muted">Chaque écriture du back-office (qui, quoi, quand, résultat). Les lectures ne sont pas journalisées.</p>
    <table>
        <thead><tr><th>Date</th><th>Acteur</th><th>Action</th><th>Cible</th><th>Résultat</th></tr></thead>
        <tbody>
            @foreach (var entry in _entries)
            {
                <tr class="@(entry.Status >= 400 ? "refused" : null)">
                    <td>@entry.At.ToString("dd/MM HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@entry.Actor[..Math.Min(8, entry.Actor.Length)]</td>
                    <td>@entry.Action</td>
                    <td>@entry.Target</td>
                    <td>@entry.Status</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private IReadOnlyList<AuditItem> _entries = [];

    protected override async Task OnInitializedAsync() => _entries = await LoadAsync(() => Api.ListAuditAsync(200)) ?? [];
}

@page "/admin/audit"
@attribute [Authorize(Policy = AdminClaims.PolicyName)]
@inherits AdminPageBase

<h1>Journal des actions</h1>
<Status Message="@Message" Error="@Error" />

<section class="card">
    <p class="muted">Chaque écriture du back-office, quel que soit le service (qui, quoi, quand, résultat, ce qui était demandé). Les lectures ne sont pas journalisées.</p>
    <div class="row">
        <div>
            <label for="service">Service</label>
            <select id="service" @onchange="OnServiceChanged">
                <option value="">Tous</option>
                <option value="factory">Factory</option>
                <option value="platform">Platform</option>
            </select>
        </div>
        <button type="button" class="ghost" @onclick="ReloadAsync">Actualiser</button>
    </div>
    <table>
        <thead><tr><th>Date</th><th>Service</th><th>Acteur</th><th>Action</th><th>Cible</th><th>Résultat</th><th>Demande</th></tr></thead>
        <tbody>
            @foreach (var entry in _entries)
            {
                <tr class="@(entry.Status >= 400 ? "refused" : null)">
                    <td>@entry.At.ToString("dd/MM HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@entry.Service</td>
                    <td>@entry.Actor[..Math.Min(8, entry.Actor.Length)]</td>
                    <td>@entry.Action</td>
                    <td>@entry.Target</td>
                    <td>@entry.Status</td>
                    <td class="muted">@entry.Summary</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private IReadOnlyList<AuditItem> _entries = [];
    private string? _service;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync() => _entries = await LoadAsync(() => Api.ListAuditAsync(200, _service)) ?? [];

    private async Task OnServiceChanged(ChangeEventArgs args)
    {
        _service = string.IsNullOrEmpty(args.Value?.ToString()) ? null : args.Value!.ToString();
        await ReloadAsync();
    }
}

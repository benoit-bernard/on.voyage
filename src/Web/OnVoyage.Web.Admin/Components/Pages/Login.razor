@page "/login"
@layout Layout.BlankLayout

<section class="card narrow">
    <h1>Atelier ON.VOYAGE</h1>
    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="alert error" role="alert">@Error</p>
    }

    @if (Step == "code")
    {
        <p>Un code à six chiffres a été envoyé à <strong>@Email</strong>.</p>
        <form method="post" action="/login/verify">
            <AntiforgeryToken />
            <input type="hidden" name="email" value="@Email" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label for="code">Code</label>
            <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus />
            <button type="submit" class="primary">Entrer</button>
        </form>
        <p><a href="/login">Utiliser une autre adresse</a></p>
    }
    else
    {
        <form method="post" action="/login/code">
            <AntiforgeryToken />
            <label for="email">Adresse e-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" required autofocus />
            <button type="submit" class="primary">Recevoir un code</button>
        </form>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "step")] private string? Step { get; set; }
    [SupplyParameterFromQuery(Name = "email")] private string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ReturnUrl")] private string? ReturnUrl { get; set; }
}

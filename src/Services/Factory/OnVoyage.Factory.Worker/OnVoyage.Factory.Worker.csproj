<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <ProjectReference Include="../OnVoyage.Factory.Application/OnVoyage.Factory.Application.csproj" />
    <ProjectReference Include="../OnVoyage.Factory.Infrastructure/OnVoyage.Factory.Infrastructure.csproj" />
    <ProjectReference Include="../OnVoyage.Factory.Contracts/OnVoyage.Factory.Contracts.csproj" />
    <ProjectReference Include="../../../Aspire/OnVoyage.ServiceDefaults/OnVoyage.ServiceDefaults.csproj" />
    <ProjectReference Include="../../../Shared/OnVoyage.Messaging/OnVoyage.Messaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The committed content snapshots (data-pipeline/<destination>/) travel with the worker: Factory:Snapshot reads <exe>/data-pipeline when nothing else is configured. -->
    <Content Include="../../../../data-pipeline/*/destination.json;../../../../data-pipeline/*/pois.json" Link="data-pipeline/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>

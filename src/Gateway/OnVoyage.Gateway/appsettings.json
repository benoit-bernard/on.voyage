{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "traveler_or_internal",
        "Match": { "Path": "/api/catalog/{**catch-all}" }
      },
      "platform-public": {
        "ClusterId": "platform",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/platform/v1/{area:regex(^(auth|config)$)}/{**catch-all}" }
      },
      "platform": {
        "ClusterId": "platform",
        "AuthorizationPolicy": "traveler",
        "Match": { "Path": "/api/platform/{**catch-all}" }
      },
      "factory": {
        "ClusterId": "factory",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/factory/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": { "Destinations": { "primary": { "Address": "https+http://catalog-api" } } },
      "platform": { "Destinations": { "primary": { "Address": "https+http://platform-api" } } },
      "factory": { "Destinations": { "primary": { "Address": "https+http://factory-api" } } }
    }
  }
}

# Copy to .env on the server (chmod 600). The deploy workflow generates it from GitHub secrets and variables: see docs/DEPLOYMENT.md.
# Never commit a real .env. Values must not contain single quotes, spaces, semicolons or '$'; generate secrets with `openssl rand -hex 32`.

# --- Public address (DNS A/AAAA records for the domain and admin.<domain> must point at the VPS)
STAGING_DOMAIN=staging.example.org
ACME_EMAIL=ops@example.org

# --- Images (GitHub Container Registry). IMAGE_TAG is the commit SHA set by the deploy workflow.
IMAGE_PREFIX=ghcr.io/benoit-bernard/onvoyage
IMAGE_TAG=staging

# --- Database (single PostGIS database, one schema per service)
POSTGRES_DB=onvoyage
POSTGRES_USER=onvoyage
POSTGRES_PASSWORD=
MIGRATE_ON_START=true

# --- Auth: HS256 key shared by Platform, the Gateway and the services (>= 32 bytes)
JWT_SECRET=
# This e-mail gets the admin role when it signs in to the back-office
BOOTSTRAP_ADMIN_EMAIL=

# --- E-mail (Resend, EU region; sender domain verified in Resend)
RESEND_API_KEY=
EMAIL_FROM=ON.VOYAGE <connexion@on.voyage>

# --- Factory / language model (OpenAI). Set FACTORY_LLM_PROVIDER=disabled to run without a model.
FACTORY_LLM_PROVIDER=openai
OPENAI_API_KEY=
FACTORY_LLM_EXTRACTOR_MODEL=
FACTORY_LLM_WRITER_MODEL=
FACTORY_LLM_VERIFIER_MODEL=
FACTORY_LLM_CLASSIFIER_MODEL=

# --- Demo data and PWA map
CATALOG_SEED_DEMO_DATA=true
PWA_MAP_TILES_URL=

# --- Backups (docs/runbooks/restore.md). PUBLIC age key only; the private key stays with the owner.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_UTC=2
BACKUP_BASEBACKUP_WEEKDAY=7

# --- Observability (observability/docker-compose.yml). Leave empty until the stack runs, then http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=
METRICS_RETENTION=30d
